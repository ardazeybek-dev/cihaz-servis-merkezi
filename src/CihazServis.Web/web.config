<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Plesk barındırma ayarı. dotnet publish bu dosyayı yayın klasörüne kopyalar.
  Bağlantı dizesi ve anahtarlar buraya YAZILMAZ: sunucudaki ortam değişkenlerinden
  (README > IIS / Plesk kurulumu) okunur.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\CihazServis.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- IIS varsayılanı 30 MB; uygulama tek istekte 3 x 10 MB ek + form alanı kabul eder (32 MB). -->
          <requestLimits maxAllowedContentLength="34000000" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
