@page
@model ErrorModel
@{
    ViewData["Title"] = "Bir sorun oluştu";
}
<div class="dar-blok">
    <div class="ust-baslik">
        <div class="etiket">Hata</div>
        <h1>Bir sorun oluştu</h1>
        <p>İsteğiniz şu an tamamlanamadı. Biraz sonra yeniden deneyin. Sorun sürerse servis talebi formundan bize ulaşabilirsiniz.</p>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="soluk">Hata kodu <code>@Model.RequestId</code></p>
        }
    </div>
    <a class="dugme" href="/">Ana sayfa</a>
</div>
