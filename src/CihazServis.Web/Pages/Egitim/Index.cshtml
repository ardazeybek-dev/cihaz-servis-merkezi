@page "/egitim"
@model CihazServis.Web.Pages.Egitim.IndexModel
@using CihazServis.Application.Egitim
@{
    ViewData["Title"] = "Eğitim";
}
<div class="ust-baslik">
    <h1>Eğitimleriniz</h1>
    <p>Dersler sırayla açılır. Her dersin videosunu izleyin, ardından beş soruyu yanıtlayın. Tüm dersleri bitirdiğinizde kullanım sertifikanız hazırlanır.</p>
    <div class="ust-gorsel" aria-hidden="true">
        <div class="mini-oynatici">
            <div class="mini-ekran">
                <span class="oynat-dugme"><svg class="ikon" focusable="false"><use href="#i-oynat" /></svg></span>
                <span class="kilit-cip"><svg class="ikon" focusable="false"><use href="#i-kilit" /></svg>İleri sarma kapalı</span>
            </div>
            <div class="mini-cubuk koyu"><span class="d64"></span></div>
            <div class="mini-oynatici-alt"><span>Süre sunucuda ölçülür</span><span>%95</span></div>
        </div>
    </div>
</div>

@foreach (var k in Model.Kurslar)
{
    var biten = k.Dersler.Count(d => d.Asama == DersAsamasi.Tamamlandi);
    <section class="kart" aria-labelledby="kurs-@k.KursId">
        <div class="yatay">
            <h2 id="kurs-@k.KursId">@k.Ad</h2>
            <span class="rozet @(biten == k.Dersler.Count ? "basari" : "vurgu")">@biten / @k.Dersler.Count ders</span>
        </div>
        <p class="soluk">@k.Aciklama</p>
        <ol class="adimlar">
            @foreach (var d in k.Dersler)
            {
                var (sinif, isaret, durum) = d.Asama switch
                {
                    DersAsamasi.Tamamlandi => ("tamam", "✓", "Tamamlandı"),
                    DersAsamasi.QuizAcik => ("acik", d.Sira.ToString(), "Video izlendi, sorular sizi bekliyor"),
                    DersAsamasi.VideoAcik => ("acik", d.Sira.ToString(), d.IzlenenOran > 0 ? $"Videonun %{(int)(d.IzlenenOran * 100)} kısmı izlendi" : "Başlamaya hazır"),
                    _ => ("kilitli", d.Sira.ToString(), "Önceki ders bitince açılır"),
                };
                <li class="@sinif" data-ders="@d.DersId" data-asama="@d.Asama">
                    <span class="ders-kapak" aria-hidden="true">
                        <span class="ders-no">@d.Sira</span>
                        <svg class="ikon" focusable="false"><use href="@(d.Asama == DersAsamasi.Kilitli ? "#i-kilit" : d.Asama == DersAsamasi.Tamamlandi ? "#i-tik" : "#i-oynat")" /></svg>
                    </span>
                    <span class="ad"><strong>@d.Baslik</strong><br /><span class="ipucu">@durum</span></span>
                    @{
                        var yuzde = d.Asama is DersAsamasi.Tamamlandi or DersAsamasi.QuizAcik ? 1.0 : Math.Clamp(d.IzlenenOran, 0, 1);
                    }
                    <span class="ilerleme-halka" aria-hidden="true">
                        <svg viewBox="0 0 44 44" focusable="false">
                            <circle class="iz" cx="22" cy="22" r="18" />
                            @if (yuzde > 0)
                            {
                                <circle class="dolu" cx="22" cy="22" r="18" stroke-dasharray="@((yuzde * 113.1).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) 113.1" />
                            }
                        </svg>
                        %@((int)(yuzde * 100))
                    </span>
                    @switch (d.Asama)
                    {
                        case DersAsamasi.VideoAcik:
                            <a class="dugme kucuk" href="/egitim/ders/@d.DersId">İzle</a>
                            break;
                        case DersAsamasi.QuizAcik:
                            <a class="dugme kucuk" href="/egitim/quiz/@d.DersId">Soruları çöz</a>
                            break;
                        case DersAsamasi.Tamamlandi:
                            <a class="dugme ikincil kucuk" href="/egitim/ders/@d.DersId">Tekrar izle</a>
                            break;
                        default:
                            <span class="rozet">Kilitli</span>
                            break;
                    }
                </li>
            }
        </ol>
        @if (k.SertifikaNo is not null)
        {
            <div class="bildirim basari ara">
                <h3>Sertifikanız hazır</h3>
                <p class="yatay">
                    <a class="dugme kucuk" href="/egitim/sertifikalar/@k.SertifikaNo/pdf">PDF olarak indir</a>
                    <a class="dugme ikincil kucuk" href="/sertifika/@k.SertifikaNo">Doğrulama sayfası</a>
                </p>
            </div>
        }
    </section>
}
