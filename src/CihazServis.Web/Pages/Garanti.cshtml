@page "/garanti"
@model GarantiModel
@using CihazServis.Application.Dogrulama
@{
    ViewData["Title"] = "Garanti sorgula";
    var y = Model.Yanit;
}
<div class="dar-blok">
    <div class="ust-baslik">
        <div class="etiket">Cihaz doğrulama</div>
        <h1>Garanti sorgula</h1>
        <p>Cihazın arka yüzündeki etikette yazan seri numarasını girin. Sonuçta yalnız model ve garanti bilgisi görünür, kayıtlı kurumun bilgileri gösterilmez.</p>
    </div>

    <form method="post" class="kart" novalidate>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bildirim hata" role="alert" tabindex="-1" data-odakla>
                <h2>Formda düzeltilmesi gereken bir alan var</h2>
                <ul>
                    @foreach (var hata in ViewData.ModelState.Where(m => m.Value!.Errors.Count > 0))
                    {
                        <li><a href="#@hata.Key">@hata.Value!.Errors[0].ErrorMessage</a></li>
                    }
                </ul>
            </div>
        }
        <div class="alan">
            <label asp-for="SeriNo"></label>
            <div class="satir">
                <input asp-for="SeriNo" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false"
                       placeholder="DMO-A240-0001" aria-describedby="seri-ipucu" aria-invalid="@(ViewData.ModelState["SeriNo"]?.Errors.Count > 0 ? "true" : null)" />
                <button class="dugme" type="submit">Sorgula</button>
            </div>
            <span class="ipucu" id="seri-ipucu">Boşluk ve tire fark etmez, küçük harfle de yazabilirsiniz.</span>
            <span asp-validation-for="SeriNo" class="alan-hata"></span>
        </div>
        <div class="tuzak" aria-hidden="true">
            <label for="Website">Bu alanı boş bırakın</label>
            <input asp-for="Website" tabindex="-1" autocomplete="off" />
        </div>
    </form>

    <div aria-live="polite">
    @if (y is not null)
    {
        <section class="kart ara" data-sonuc="@y.Sonuc">
            @if (y.Sonuc == DogrulamaSonucu.Bulundu)
            {
                var (sinif, etiket) = y.Garanti!.Durum switch
                {
                    GarantiDurumu.Bitti => ("hata", "Garanti bitti"),
                    GarantiDurumu.YakindaBitiyor => ("uyari", "Garanti yakında bitiyor"),
                    _ => ("basari", "Garanti devam ediyor"),
                };
                <p><span class="rozet @sinif">@etiket</span> <span class="rozet vurgu">Hizmet: @y.HizmetSeviyesi</span></p>
                <h2>@y.Model!.Ad</h2>
                <dl class="ozellikler">
                    <dt>Seri numarası</dt><dd class="mono">@y.SeriNo</dd>
                    <dt>Garanti bitişi</dt><dd>@y.Garanti.Bitis.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</dd>
                    @if (y.Garanti.Durum != GarantiDurumu.Bitti)
                    {
                        <dt>Kalan süre</dt><dd>@y.Garanti.KalanGun gün</dd>
                    }
                </dl>
                <p class="ara">@y.Mesaj</p>
                <a class="dugme ikincil" href="@y.ServisTalebiAdresi">Bu cihaz için servis talebi aç</a>
            }
            else
            {
                <div class="bildirim uyari">
                    <h2>@(y.Sonuc == DogrulamaSonucu.GecersizBicim ? "Seri numarası biçimi tanınmadı" : "Kayıt bulunamadı")</h2>
                    <p>@y.Mesaj</p>
                </div>
                <a class="dugme" href="@y.ServisTalebiAdresi">Servis talebi aç</a>
            }
        </section>
    }
    </div>
</div>
