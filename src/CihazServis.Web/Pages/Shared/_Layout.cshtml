@{
    var yol = Context.Request.Path.Value ?? "/";
    string? Aktif(string onek) => (onek == "/" ? yol == "/" : yol.StartsWith(onek, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
    var girisli = User.Identity?.IsAuthenticated == true;
    var personel = User.IsInRole("Personel") || User.IsInRole("Yonetici");
    var tamGenislik = ViewData["TamGenislik"] is true;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Cihaz Servis Merkezi" : "Cihaz Servis Merkezi")</title>
    <meta name="description" content="@(ViewData["Aciklama"] ?? "Garanti sorgusu, servis talebi, talep durumu ve cihaz kullanım eğitimi.")" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
</head>
<body>
    <partial name="_Ikonlar" />
    <a class="gizli-baglanti" href="#icerik">İçeriğe geç</a>
    <div class="demo-serit">Örnek veridir, gerçek müşteri verisi içermez.</div>
    <header class="ust">
        <div class="kap">
            <a class="marka" href="/"><svg class="marka-isaret" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" /><path d="M6 17h4.5l2.5-6 4.5 11 2.5-5H26" /></svg> Cihaz Servis Merkezi</a>
            <nav aria-label="Ana menü">
                <ul class="menu">
                    <li><a href="/garanti" aria-current="@Aktif("/garanti")">Garanti sorgula</a></li>
                    <li><a href="/servis/talep" aria-current="@Aktif("/servis/talep")">Servis talebi</a></li>
                    <li><a href="/servis/durum" aria-current="@Aktif("/servis/durum")">Talep durumu</a></li>
                    <li><a href="/egitim" aria-current="@Aktif("/egitim")">Eğitim</a></li>
                    @if (User.IsInRole("Musteri"))
                    {
                        <li><a href="/musteri/cihazlar" aria-current="@Aktif("/musteri")">Cihazlarım</a></li>
                    }
                    @if (personel)
                    {
                        <li><a href="/yonetim" aria-current="@Aktif("/yonetim")">Yönetim</a></li>
                    }
                    @if (girisli)
                    {
                        <li>
                            <form method="post" asp-page="/Cikis">
                                <button type="submit">Çıkış</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li><a href="/giris" aria-current="@Aktif("/giris")">Giriş</a></li>
                    }
                </ul>
            </nav>
        </div>
    </header>
    <main id="icerik" tabindex="-1" class="@(tamGenislik ? "tam" : null)">
        @if (tamGenislik)
        {
            @RenderBody()
        }
        else
        {
            <div class="kap">
                @RenderBody()
            </div>
        }
    </main>
    <footer class="alt">
        <div class="kap">
            <span>Cihaz Servis Merkezi · örnek uygulama</span>
            <span><a href="/aydinlatma-metni">Aydınlatma metni</a> · <a href="/openapi/v1.json">API belgesi</a></span>
            @await RenderSectionAsync("AltNot", required: false)
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
